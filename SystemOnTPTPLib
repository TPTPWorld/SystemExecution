sub StatusFromSystemOutput {
    my ($QuietFlag,$SystemFileHandle,$System,$TimeLimit,$WCTimeLimit) = @_;

    my @SystemInfos;
    my $SystemInfo;
    my $SolvedString;
    my $SolvedType;
    my @SolvedStrings;
    my %SolvedStrings;
    my $NotSolvedString;
    my $NotSolvedType;
    my @NotSolvedStrings;
    my %NotSolvedStrings;
    my $StartSolnString;
    my $StartSolnType;
    my @StartSolnStrings;
    my %StartSolnStrings;
    my $EndSolnString;
    my $EndSolnType;
    my @EndSolnStrings;
    my %EndSolnStrings;
    my $ProblemSolved;
    my $SystemOutputLine;
    my $SystemPart;
    my $Status;
    my $LineCPUTime;
    my $LineRealTime;
    my $CPUTime;
    my $RealTime;
    my $OutputStatus;
    my $OutputCPUTime;
    my $OutputRealTime;
    my @StatisticValues;
    my $StatisticValues;
    my %StatisticValues;
    my $StatisticSpec;
    my @StatisticSpecs;
    my $StatisticName;
    my $StatisticRegexp;
    my @StatisticNames;
    my %StatisticRegexps;

#----Get strings to look for
    NoNastyUNIX("$GetSystemInfoCommand Solved NotSolved StartSoln EndSoln Statistic");
    (@SystemInfos) = grep(/^\Q$System\E *=>/,
`$GetSystemInfoCommand Solved NotSolved StartSoln EndSoln Statistic`);
    if (scalar(@SystemInfos) != 1) {
        die("ERROR: Not one line of information for $System\n");
    }
    $SystemInfo = $SystemInfos[0];
    chomp($SystemInfo);
    ($SolvedString,$NotSolvedString,$StartSolnString,$EndSolnString,
$StatisticSpec) = ($SystemInfo =~ 
/\Q$System\E *=> *([^;]*); *([^;]*); *([^;]*); *([^;]*); *([^;]*);/);

#----Sort out solved strings
    if ($SolvedString ne "NO INFORMATION") {
        @SolvedStrings = split(/ && /,$SolvedString);
        foreach $SolvedString (@SolvedStrings) {
            ($SolvedType,$SolvedString) = ($SolvedString =~ /([^ ]*) = (.*)/);
            $SolvedStrings{$SolvedType} = $SolvedString;
        }
    }
#----Sort out not solved strings
    if ($NotSolvedString ne "NO INFORMATION") {
        @NotSolvedStrings = split(/ && /,$NotSolvedString);
        foreach $NotSolvedString (@NotSolvedStrings) {
            ($NotSolvedType,$NotSolvedString) = 
($NotSolvedString =~ /([^ ]*) = (.*)/);
            $NotSolvedStrings{$NotSolvedType} = $NotSolvedString;
        }
    }
#----Sort out start solution strings
    if ($StartSolnString ne "NO INFORMATION") {
        @StartSolnStrings = split(/ && /,$StartSolnString);
        foreach $StartSolnString (@StartSolnStrings) {
            ($StartSolnType,$StartSolnString) = 
($StartSolnString =~ /([^ ]*) = (.*)/);
            $StartSolnStrings{$StartSolnType} = $StartSolnString;
        }
    }
#----Sort out end solution strings
    if ($EndSolnString ne "NO INFORMATION") {
        @EndSolnStrings = split(/ && /,$EndSolnString);
        foreach $EndSolnString (@EndSolnStrings) {
            ($EndSolnType,$EndSolnString) = 
($EndSolnString =~ /([^ ]*) = (.*)/);
            $EndSolnStrings{$EndSolnType} = $EndSolnString;
        }
    }
#----Sort out statistic specs
    if ($StatisticSpec ne "NO INFORMATION") {
        @StatisticSpecs = split(/ && /,$StatisticSpec);
        foreach $StatisticSpec (@StatisticSpecs) {
            ($StatisticName,$StatisticRegexp) = 
($StatisticSpec =~ /([^ ]*) = (.*)/);
            @StatisticNames = (@StatisticNames,$StatisticName);
            $StatisticRegexps{$StatisticName} = $StatisticRegexp;
        }
    }

#----Read system output to try find a result status
    $ProblemSolved = 0;
    $Status = $UnknownStatus;
    $CPUTime = 0;
    $RealTime = 0;
    $OutputStatus = $NoneStatus;
    $OutputCPUTime = 0;
    $OutputRealTime = 0;
    undef($EndSolnType);

    QuietPrint($QuietFlag,1,"% START OF SYSTEM OUTPUT\n");
    while(defined($SystemOutputLine = <$SystemFileHandle>)) {
        if ($SystemOutputLine =~ /^ERROR:/) {
            die("$SystemOutputLine");
        }
#----Extract the times from the line
#DEBUG print("Dirty line ===$SystemOutputLine===\n");
        ($LineCPUTime,$LineRealTime) = ($SystemOutputLine =~ /^([0-9\.]*)\/([0-9\.]*)\t/);
#DEBUG print("Extracted times $LineCPUTime,$LineRealTime\n");
        $SystemOutputLine =~ s/^[^\t]*\t//;
#DEBUG print("Cleaned line ===$SystemOutputLine===\n");
#----Only check output if not interrupted
        if (!$GlobalInterruptedInLib) {
            if ($Status eq $UnknownStatus) {
                foreach $SolvedType (keys(%SolvedStrings)) {
#----Note lack of \Q \E here so regexp can be used. Beware!
                    if ($SolvedStrings{$SolvedType} eq "StartOfFile" ||
$SystemOutputLine =~ /$SolvedStrings{$SolvedType}/) {
                        $Status = $SolvedType;
#----At least an assurance
                        if ($OutputStatus eq $NoneStatus) {
                            $OutputStatus = $AssuranceStatus;
                            $OutputCPUTime = $LineCPUTime;
                            $OutputRealTime = $LineRealTime;
                        }
                        $CPUTime = $LineCPUTime;
                        $RealTime = $LineRealTime;
                        $ProblemSolved = 1;
                        last;
                    }
                }
                foreach $NotSolvedType (keys(%NotSolvedStrings)) {
#----Note lack of \Q \E here so regexp can be used. Beware!
                    if ($SystemOutputLine =~ /$NotSolvedStrings{$NotSolvedType}/) {
                        $Status = $NotSolvedType;
#----At least an assurance
                        $OutputStatus = $NoneStatus;
                        $OutputCPUTime = $LineCPUTime;
                        $OutputRealTime = $LineRealTime;
                        $CPUTime = $LineCPUTime;
                        $RealTime = $LineRealTime;
                        $ProblemSolved = 1;
                        last;
                    }
                }
            }

#----Check if start of solution string is there, if no previous
#----solution started
            if (!defined($EndSolnType)) {
                foreach $StartSolnType (keys(%StartSolnStrings)) {
#DEBUG print("Look for $StartSolnStrings{$StartSolnType} in $SystemOutputLine\n");
                    if ((exists($StartSolnStrings{$StartSolnType}) &&
$StartSolnStrings{$StartSolnType} eq "StartOfFile") ||
$SystemOutputLine =~ /\Q$StartSolnStrings{$StartSolnType}\E/) {
                        $EndSolnType = $StartSolnType;
                        last;
                    }
                }
            }
#----Check if end of solution string is there
#DEBUG print("Look for $EndSolnStrings{$StartSolnType} in $SystemOutputLine\n");
            if (defined($EndSolnType) &&
$SystemOutputLine =~ /\Q$EndSolnStrings{$EndSolnType}\E/) {
                $OutputStatus = $EndSolnType;
                $OutputCPUTime = $LineCPUTime;
                $OutputRealTime = $LineRealTime;
            }

#----Check for last times
#DEBUG print("In SfSO ==$Status==$UnknownStatus==$SystemOutputLine==\n");
#----If accepting until end of file, catch that here
            if (defined($EndSolnType) &&
$EndSolnStrings{$EndSolnType} eq "EndOfFile" && $SystemOutputLine =~ /^EOF$/) {
                $OutputStatus = $EndSolnType;
                $OutputCPUTime = $LineCPUTime;
                $OutputRealTime = $LineRealTime;
            }
            if ($Status eq $UnknownStatus && $SystemOutputLine =~ /^EOF$/) {
                $CPUTime = $LineCPUTime;
                $RealTime = $LineRealTime;
            }

#----Check for statistic values
            foreach $StatisticName (@StatisticNames) {
                if ($SystemOutputLine =~ /$StatisticRegexps{$StatisticName}/) {
                    ($StatisticValues{$StatisticName}) = 
($SystemOutputLine =~ /$StatisticRegexps{$StatisticName}/);
                    if ($StatisticValues{$StatisticName} =~ / /) {
                        $StatisticValues{$StatisticName} = 
"'$StatisticValues{$StatisticName}'";
                   }
                }
            }
            if ($SystemOutputLine !~ /^EOF$/) {
                QuietPrint($QuietFlag,1,"$SystemOutputLine");
            }
        } else {
#----Print line anyway if global interrupted, and waiting for system to end
            if ($SystemOutputLine !~ /^EOF$/) {
                QuietPrint($QuietFlag,0,"$SystemOutputLine");
            }
        }
    }
    QuietPrint($QuietFlag,1,"\n% END OF SYSTEM OUTPUT\n");

#----Check if a solution was output, but no solution claimed to be found
    if (!$ProblemSolved && $OutputStatus ne $NoneStatus) {
        QuietPrint($QuietFlag,1,"% WARNING: Not solved but solution found\n");
        $OutputStatus = $NoneStatus;
        $OutputCPUTime = 0;
        $OutputRealTime = 0;
        undef($EndSolnType);
    }

#----If the time taken is greater than the limit, then timeout
    if ($CPUTime > $TimeLimit || (!$ProblemSolved && 
$CPUTime * $NotSolvedCPUTimeScale > $TimeLimit)) {
        $Status = $TimeoutStatus;
#----If system gave up because it thought time out, fix the time taken
        if ($CPUTime < $TimeLimit) {
            $CPUTime = $TimeLimit;
        }
#----Don't adjust real time - can be less due to multicore processing
#        if ($RealTime < $TimeLimit) {
#            $RealTime = $TimeLimit;
#        }
#----No output accepted if timed out
        $OutputStatus = $NoneStatus;
        $OutputCPUTime = 0;
        $OutputRealTime = 0;
        undef($EndSolnType);
    }

#----If the time taken is greater than the limit, then timeout
    if ($RealTime > $WCTimeLimit || (!$ProblemSolved && 
$RealTime * $NotSolvedCPUTimeScale > $WCTimeLimit)) {
        $Status = $TimeoutStatus;
#----If system gave up because it thought time out, fix the time taken
        if ($RealTime < $WCTimeLimit) {
            $RealTime = $WCTimeLimit;
        }
#----No output accepted if timed out
        $OutputStatus = $NoneStatus;
        $OutputCPUTime = 0;
        $OutputRealTime = 0;
        undef($EndSolnType);
    }

#----Make stats output line
    $StatisticValues = "";
    foreach $StatisticName (@StatisticNames) {
        if (exists($StatisticValues{$StatisticName})) {
            if (QuietLevelFromFlag($QuietFlag) <= 2) {
                $StatisticValues = 
"$StatisticValues $StatisticName = $StatisticValues{$StatisticName}";
            } else {
                $StatisticValues = 
"$StatisticValues $StatisticValues{$StatisticName}";
            }
        }
    }

    return($Status,$CPUTime,$RealTime,$OutputStatus,$OutputCPUTime,
$OutputRealTime,$StatisticValues);
}
