sub NoNastyUNIX {
    my ($ToBeClean) = @_;

#----These lines added to prevent the pipe hack
    if ($ToBeClean =~ /[`\|;\&<>]/) {
        print("Illegal character in $ToBeClean\n");
        die("Illegal character in $ToBeClean\n");
    }
    if ($ToBeClean =~ /\.\.\//) {
        print("Illegal path in $ToBeClean\n");
        die("Illegal path in $ToBeClean\n");
    }
}
