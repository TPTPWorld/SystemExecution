sub ATPTPProblem {
    my ($Problem) = @_;

    my $Domain;

    $Problem =~ s/\.p$//;
    if ($Problem =~ /^[A-Z]{3}[0-9]{3}/) {
        ($Domain) = ($Problem =~ /^(...)/);
        return(-f "$ProblemsDirectory/$Domain/${Problem}.p");
    } else {
        return(0);
    }
}
