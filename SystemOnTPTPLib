#--------------------------------------------------------------------------------------------------
sub SetGlobalInterruptedInLib {

    $GlobalInterruptedInLib = 1;
}
#--------------------------------------------------------------------------------------------------
sub RunSystemOnTPTP {
    my ($TemporaryDirectory) = @_;

    my $QuietFlag;
    my $KeepTemporaryDirectory;

    InfoOptions();
    $QuietFlag = GetQuietFlag();
    SystemOnTPTPVersionSetup($QuietFlag,@ARGV);
    ($TemporaryDirectory,$KeepTemporaryDirectory) = CommonStartSystemOnTPTP($QuietFlag,
$TemporaryDirectory,@ARGV);

    return($TemporaryDirectory,$KeepTemporaryDirectory);
}
#--------------------------------------------------------------------------------------------------
sub InfoOptions {

    if (scalar(@ARGV) == 0 || $ARGV[0] eq "-h") {
        Usage();
        die("\n");
    }

    if ($ARGV[0] eq "-w") {
        shift(@ARGV);
        ListAvailableSystems(@ARGV);
        die("\n");
    }

}
#--------------------------------------------------------------------------------------------------
sub Usage {

    print("
Usages are 
    SystemOnTPTP -h|-w
    SystemOnTPTP [-qN] [-force] [-k tmpdir] system [flags] time_limit [-m memory_limit in MB] [-n nice_value] [-S] [-F|-O] problems | -l|-L problem_list_file
");
}
#--------------------------------------------------------------------------------------------------
sub ListAvailableSystems {
    my (@Args) = @_;

    my $ListStatus;
    my @Systems;
    my $System;

    if (!defined($ListStatus = shift(@Args))) {
        $ListStatus = "READY";
    } 

    @Systems = `$GetSystemInfoCommand Status @Args`;
    foreach $System (@Systems) {
        chomp($System);
        if ($System =~ /=> [^;]*$ListStatus/) {
            $System =~ s/=> [^;]*;/=> /;
            if ($System =~ /=> *$/) {
                $System =~ s/ *=> *$//;
            }
            print("$System\n");
        }
    }
}
#--------------------------------------------------------------------------------------------------
sub GetQuietFlag {

    my $QuietFlag;

#----Check for quiet argument
    if (defined($QuietFlag = $ARGV[0]) && $QuietFlag =~ /^-q\d/) {
        shift(@ARGV);
    } else {
        $QuietFlag = "-q0";
    }

    return($QuietFlag);
}
#--------------------------------------------------------------------------------------------------
sub CommonStartSystemOnTPTP {
    my ($QuietFlag,$TemporaryDirectory,@CommandLineArguments) = @_;

    my $ForceSystemFlag;
    my $KeepTemporaryDirectory;
    my @SystemNames;
    my $SystemName;

#----Redirect STDERR to STDOUT
    close(STDERR);
    open(STDERR,">&STDOUT") || die("Cannot redirect STDERR to STDOUT\n");
#----Flush output
    $| = 1;

#----Check if systems is forced to try this problem - no checking will be done
    if (defined($ForceSystemFlag = $CommandLineArguments[0]) && $ForceSystemFlag eq "-force") {
        shift(@CommandLineArguments);
    } else {
        $ForceSystemFlag = "";
    }

#----Check for a user defined temporary directory which must be saved
    if (defined($CommandLineArguments[0]) && 
$CommandLineArguments[0] eq "-k") {
        shift(@CommandLineArguments);
        if (defined($TemporaryDirectory = shift(@CommandLineArguments)) &&
$TemporaryDirectory =~ /^[\/\.]/) {
            $KeepTemporaryDirectory = 1;
        } else {
            Usage();
            die("\n");
        }
    } else {
        $KeepTemporaryDirectory = 0;
    }

#----Check there were enough parameters
    if (@ARGV < 3) {
        Usage();
        die("\n");
    }

#----Make the temporary directory
    if (! -d $TemporaryDirectory) {
        if (!mkdir($TemporaryDirectory,0777)) {
            print("ERROR: Cannot make temp dir $TemporaryDirectory\n");
            die("\n");
        }           
    }
#----Change permissions so tptp can cleanup later if needed
    system("chmod 0777 $TemporaryDirectory");

#----Run the systems. The CommandLineArguments may have multiple system specifications. Multiple
#----systems cannot have non-default parameters, except for the last system.
    @SystemNames = ();
    while ($CommandLineArguments[0] =~ /---/) {
        push(@SystemNames,CompleteSystemName($QuietFlag,$CommandLineArguments[0]));
        shift(@CommandLineArguments);
    }
    foreach $SystemName (@SystemNames) {
        DoSystemOnTPTP($QuietFlag,$ForceSystemFlag,$TemporaryDirectory,$SystemName,
@CommandLineArguments);
#----Stop if interrupted
        if ($GlobalInterruptedInLib) {
            last;
        }
    }

    return($TemporaryDirectory,$KeepTemporaryDirectory);
}
#--------------------------------------------------------------------------------------------------
sub CompleteSystemName {
    my ($QuietFlag,$RequestedSystemName) = @_;

    my @SystemNames;
    my @SystemInfoLines;
    my $System;

    @SystemNames = ();
    @SystemInfoLines = `$GetSystemInfoCommand $RequestedSystemName Status`;
    if (scalar(@SystemInfoLines) == 0) {
        print("WARNING: $RequestedSystemName does not exist - ignored\n");
    } else {
        foreach $System (@SystemInfoLines) {
            if ($System =~ /READY/) {
                chomp($System);
                $System =~ s/ .*//;
                push(@SystemNames,($System));
            } else {
                chomp($System);
                $System =~ s/ .*//;
                QuietPrint($QuietFlag,1,"$System is not READY\n");
            }
        }
    }

    return(@SystemNames);
}
