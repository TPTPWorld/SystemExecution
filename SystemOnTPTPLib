sub CheckParameters {
    my ($QuietFlag,$System,$TemporaryDirectory,@FlagsTimeAndProblems) = @_;

    my $ProblemFile;
    my $Problem;
    my $ProblemListFile;
    my $ProblemListHandle = "ProblemListHandle";
    my @ProblemFiles;
    my $ExecuteFormatString;
    my $OldBinary;
    my $NewArgs;
    my $Format;
    my $Transform;
    my $TimeLimit;
    my $WCTimeLimit;
    my $NiceValue;
    my $MemoryLimit;
    my $SystemMemoryLimit;
    my $NeedFormatter;
    my $NeedOtter2TPTP;
    my $UseX2tptp;
    my $UsingSoTFlag;
    my $SystemInfo;
    my $SystemExecutable;
    my $SystemParameters;
    my $OptionalFlag;
    my $OptionalFlagValue;
    my $TempHandle;
    my $Line;

#----Set up defaults which may be overridden
    $MemoryLimit = $DefaultMemoryLimit;
    $NiceValue = $DefaultNiceValue;

#----Get system information
    QuietPrint($QuietFlag,2,"$System   system information being retrieved\n");
    NoNastyUNIX("$GetSystemInfoCommand Command MemoryLimit Format Transform");
    ($SystemInfo) = grep(/^\Q$System\E *=>/,
`$GetSystemInfoCommand Command MemoryLimit Format Transform`);
#----Check there is exactly one system
    if (!defined($SystemInfo)) {
        system("rm -rf $TemporaryDirectory\n");
        die("ERROR: $System is not listed or is multiply defined\n");
    }
#----Extract required components
    ($ExecuteFormatString,$SystemMemoryLimit,$Format,$Transform) = 
    ($SystemInfo =~ /\Q$System\E *=> *([^;]*); *([^;]*); *([^;]*); *([^;]*);/);

#----Check for system specific memory limit
    if ($SystemMemoryLimit =~ /\d+/) {
        $MemoryLimit = $SystemMemoryLimit * 1024 * 1024;
    }

#----Replace default values with any specified
    QuietPrint($QuietFlag,2,"${System}'s non-default parameters being retrieved");
    while (defined($FlagsTimeAndProblems[0]) && ($FlagsTimeAndProblems[0] =~
/^-[ftx]$/) && defined($FlagsTimeAndProblems[1])) {
        $OptionalFlag = shift(@FlagsTimeAndProblems);
        $OptionalFlagValue = shift(@FlagsTimeAndProblems);
        QuietPrint($QuietFlag,2,"\n    $OptionalFlag $OptionalFlagValue");
        if ($OptionalFlag eq "-f") {
            NoNastyUNIX($OptionalFlagValue);
            $Format = $OptionalFlagValue;
        }
        if ($OptionalFlag eq "-t") {
            NoNastyUNIX($OptionalFlagValue);
            $Transform = $OptionalFlagValue;
        }
        if ($OptionalFlag eq "-x") {
#----Do not allow binary name to be changed (hack prevention)
            ($OldBinary) = ($ExecuteFormatString =~ /^([^ ]*)/);
            ($NewArgs) = ($OptionalFlagValue =~ /^[^ ]* (.*)/);
            NoNastyUNIX($NewArgs);
            $ExecuteFormatString = "$OldBinary $NewArgs";
        }
    }
    QuietPrint($QuietFlag,2,"\n");

#----Check the system executable
    QuietPrint($QuietFlag,0,"$System   being checked for execution\n");

#----Split system executable name from its parameters
    ($SystemExecutable,$SystemParameters) = ($ExecuteFormatString =~ /^([^ ]*) *(.*)/);
#----Add directory onto front of system executable, and check it is executable
    if ($SystemExecutable !~ /^\//) {
        $SystemExecutable = "$SystemsDirectory/$System/$SystemExecutable";
    }
    if (!(-x $SystemExecutable)) {
        system("rm -rf $TemporaryDirectory\n");
        die("ERROR $SystemExecutable is not executable\n");
    }
#----Rebuild the command format string
    $ExecuteFormatString = "$SystemExecutable $SystemParameters";

#----Check the time limit
    if (defined($TimeLimit = shift(@FlagsTimeAndProblems))) {
        QuietPrint($QuietFlag,0,"$System   checking time limit $TimeLimit\n");
        if ($TimeLimit !~ /^-?\d+$/ || $TimeLimit > $MaximalTimeLimit) {
            system("rm -rf $TemporaryDirectory\n");
            die("ERROR: $TimeLimit is outside the time limit range $MaximalTimeLimit\n");
        } 
        $WCTimeLimit = $TimeLimit * $CPUWCLimitScaleFactor;
    } else {
        system("rm -rf $TemporaryDirectory\n");
        die("ERROR: No time limit given\n");
    }

#----See if an explicit wall clock time limit is given
    if (scalar(@FlagsTimeAndProblems) > 1 && $FlagsTimeAndProblems[0] eq "-w") {
        shift(@FlagsTimeAndProblems);
        $WCTimeLimit = shift(@FlagsTimeAndProblems);
        if ($MemoryLimit !~ /^\d+$/ || $MemoryLimit < 0) {
            system("rm -rf $TemporaryDirectory\n");
            die("ERROR: Wall clock limit $WCTimeLimit is weird\n");
        }
    } 

#----See if a memory limit has been given
    if (scalar(@FlagsTimeAndProblems) > 1 && $FlagsTimeAndProblems[0] eq "-m") {
        shift(@FlagsTimeAndProblems);
        $MemoryLimit = shift(@FlagsTimeAndProblems);
        if ($MemoryLimit !~ /^\d+$/ || $MemoryLimit < 0) {
            system("rm -rf $TemporaryDirectory\n");
            die("ERROR: Memory limit $MemoryLimit is weird\n");
        }
        $MemoryLimit *= (1024*1024);
    } 

#----See if a nice value has been given
    if (scalar(@FlagsTimeAndProblems) > 1 && $FlagsTimeAndProblems[0] eq "-n") {
        shift(@FlagsTimeAndProblems);
        $NiceValue = shift(@FlagsTimeAndProblems);
        if ($NiceValue !~ /^[\d-]+$/) {
            system("rm -rf $TemporaryDirectory\n");
            die("ERROR: Nice value $NiceValue is weird\n");
        }
    } 

#----See if X2tptp postprocessing is required
    if (scalar(@FlagsTimeAndProblems) > 0 && $FlagsTimeAndProblems[0] eq "-S") {
#----Suppress for tptp[24]X
        if ($System =~ /^tptp[24]X/) {
            $UseX2tptp = 0;
        } else {
            $UseX2tptp = 1;
        }
        shift(@FlagsTimeAndProblems);
    } else {
        $UseX2tptp = 0;
    }

#----Get the problem files list
    $NeedFormatter = 0;
    $NeedOtter2TPTP = 0;
#----See if they are listed in a file
    if ($FlagsTimeAndProblems[0] eq "-l" || $FlagsTimeAndProblems[0] eq "-L") {
        if (defined($ProblemListFile = $FlagsTimeAndProblems[1]) && -r $ProblemListFile) {
#----Note if formatter is needed -l => yes, -L => no
            $NeedFormatter = $FlagsTimeAndProblems[0] eq "-l";
#----Read them all
            NoNastyUNIX($ProblemListFile);
            open($ProblemListHandle,"<$ProblemListFile") ||
die("ERROR: Cannot read $ProblemListFile\n");
            QuietPrint($QuietFlag,0,"$System   getting problem list\n");
            @FlagsTimeAndProblems = ();
            while (defined($ProblemFile = <$ProblemListHandle>)) {
                chomp($ProblemFile);
#For lists with following crap $ProblemFile =~ s/ .*//;
                push(@FlagsTimeAndProblems,("$ProblemFile"));
                }
            close($ProblemListHandle);
        } else {
            system("rm -rf $TemporaryDirectory\n");
            die("ERROR: Problem list file missing or unreadable\n");
        }
#----Otherwise the files have been listed directly
#----Check if already formatted
    } elsif ($FlagsTimeAndProblems[0] eq "-F") {
        $NeedFormatter = 0;
        shift(@FlagsTimeAndProblems);
#----Otter format input
    } elsif ($FlagsTimeAndProblems[0] eq "-O") {
        $NeedOtter2TPTP = 1;
        $NeedFormatter = 1;
        shift(@FlagsTimeAndProblems);
    } else {
        $NeedFormatter = 1;
    }

#----Go through each one and check it's reasonable
    foreach $ProblemFile (@FlagsTimeAndProblems) {
        QuietPrint($QuietFlag,0,"$System   checking problem name $ProblemFile\n");
        if (!(-r "$ProblemFile")) {
#----Check reading STDIN
            if ($ProblemFile eq "--") {
                $Problem = "stdin";
                ($TempHandle,$ProblemFile) = 
mkstemp("$TemporaryDirectory/STDIN_XXXXXX");
                while (defined($Line = <STDIN>)) {
                    print($TempHandle $Line);
                }
                close($TempHandle);
#----If it looks like a TPTP, let tptp?X find it
            } else {
#----Extract base file name
                NoNastyUNIX($ProblemFile);
                $Problem = `basename '$ProblemFile' '\\.[a-z]*'`;
                chomp($Problem);
                if ($Problem =~ 
/^[A-Z]{3}[0-9]{3}[+-^=_][1-9][0-9]*(\.[0-9]{3}(\.[0-9]{3})*)?$/) {
                    $ProblemFile = $Problem;
#----Otherwise not a real problem
                } else {
                    system("rm -rf $TemporaryDirectory\n");
                    print("ERROR: $ProblemFile is not readable or TPTP-like\n");
                    die("\n");
                }
            }
        }
        push(@ProblemFiles,($ProblemFile));
    }

#----Check for a negative time limit, in which case only postprocess
    if ($TimeLimit < 0) {
        $NeedOtter2TPTP = 0;
        $NeedFormatter = 0;
        $UsingSoTFlag = "";
        $ExecuteFormatString = $CatEchoCommand;
    } else {
        $UsingSoTFlag = "-sot";
    }

#----Return the valid information
    return($ExecuteFormatString,$Format,$Transform,$TimeLimit,$WCTimeLimit,$MemoryLimit,$NiceValue,
$NeedFormatter,$NeedOtter2TPTP,$UseX2tptp,$UsingSoTFlag,@ProblemFiles);
}
#--------------------------------------------------------------------------------------------------
sub ConvertFromOtter {
    my ($QuietFlag,$TemporaryDirectory,@ProblemFiles) = @_;

    my $InputFile;
    my $OutputFile;
    my @OutputFiles;
    my $Basename;

    foreach $InputFile (@ProblemFiles) {
        QuietPrint($QuietFlag,2,"Converting $InputFile from Otter to TSTP\n");
        NoNastyUNIX($InputFile);
        $Basename = `basename '$InputFile'`;
        chomp($Basename);
        $OutputFile = "$TemporaryDirectory/$Basename";
        system("$Otter2TPTPCommand < $InputFile > $OutputFile");
        push(@OutputFiles,($OutputFile));
    }

    return(@OutputFiles);
}
