sub DoTPTP4X {
    my ($TemporaryDirectory,$ExtraTPTP4XFlags,$Transform,$Format,@ProblemFiles) = @_;

    my $ExpandFlag;
    my $ProblemFiles;
    my $ProblemFile;

    NoNastyUNIX("$tptp4XCommand $ExtraTPTP4XFlags -d $TemporaryDirectory -t '$Transform' -f '$Format' -x -u machine @ProblemFiles");
    if ($Format eq "tptp:raw") {
        $ExpandFlag = "";
        $Format = "tptp";
    } else {
        $ExpandFlag = "-x";
    }
    $ProblemFiles = "";
    foreach $ProblemFile (@ProblemFiles) {
        $ProblemFiles .= "'$ProblemFile' ";
    }
    return(`$tptp4XCommand $ExtraTPTP4XFlags -d $TemporaryDirectory -t '$Transform' -f '$Format' $ExpandFlag -u machine $ProblemFiles 2>&1 | cat`);
}
