sub ExtractTime {
    my $TimeLine = $_[0];
    my $TimeType = $_[1];

    my $Hours;
    my $Minutes;
    my $Seconds;
    my $Tenths;

#----Try extract a time with hours
    ($Hours,$Minutes,$Seconds,$Tenths) =
    ($TimeLine  =~ /^$TimeType *([0-9]+):([0-9]+):([0-9]+)\.([0-9])/);
#----If no hours, extract with minutes
    if (!defined($Hours)) {
        $Hours = 0;
        ($Minutes,$Seconds,$Tenths) =
($TimeLine  =~ /^$TimeType *([0-9]+):([0-9]+)\.([0-9])/);
    }
#----If no minutes, extract with seconds (always there)
    if (!defined($Minutes)) {
        $Minutes = 0;
        ($Seconds,$Tenths) = ($TimeLine  =~ /^$TimeType *([0-9]+)\.([0-9])/);
    }

#----If no seconds, then undefined
    if (!defined($Seconds)) {
        return(undef);
    } else {
#----Compute final time in seconds
        return($Hours * 3600 + $Minutes * 60 + $Seconds + $Tenths/10);
    }
}
