my $ServiceDirectory = "$TPTPDirectory/ServiceTools";
my $Otter2TPTPCommand = "$ServiceDirectory/Otter2TPTP/Otter2TPTP";
my $tptp4XCommand = "$ServiceDirectory/tptp4X";
my $CatEchoCommand = "cat %s";
my $GrepCommand = "grep";

#----System parameter
my $MaximalTimeLimit = 72000;
my $CPUWCLimitScaleFactor = 2;
# my $DefaultMemoryLimit = "256000000";
my $DefaultMemoryLimit = "0";
my $DefaultNiceValue = "0";
#----Scale CPU time up for not solved to make Timeout
my $NotSolvedCPUTimeScale = 1.05;

#----Solution strings to use
my $TimeoutStatus = "Timeout";
