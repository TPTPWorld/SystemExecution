sub FixFOFResult {
    my ($Status,$FileName) = @_;

    my $ConjectureLines;

    NoNastyUNIX($FileName);
    if ($Status eq "Unsatisfiable" || $Status eq "Satisfiable" || 
$Status eq "Theorem" || $Status eq "CounterSatisfiable") {
        $ConjectureLines = 
`$GrepCommand -c '^ *input_formula(.*, *conjecture *,' '$FileName'` + 
#----Match fof, tff, thf, qmf; match for conjecture, question conjecture-local, conjecture-global
`$GrepCommand -c -E '^ *[ftq][omfh]f\\(.*, *(conjecture|question)(-(local|global))? *,' '$FileName'` +
`$GrepCommand -c 'This is the conjecture' '$FileName'`;
#DEBUG system("cat $FileName");
#DEBUG print("ConjectureLines $ConjectureLines  Status $Status\n");
        if ($ConjectureLines > 0) {
            if ($Status eq "Unsatisfiable") {
                return("Theorem");
            }
            if ($Status eq "Satisfiable") {
                return("CounterSatisfiable");
            }
        } else {
            if ($Status eq "Theorem") {
                return("Unsatisfiable");
            }
            if ($Status eq "CounterSatisfiable") {
                return("Satisfiable");
            }
        }
    }
    return($Status);
}
