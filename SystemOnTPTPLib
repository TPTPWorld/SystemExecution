sub AllReadableFiles {
    my (@ProblemFiles) = @_;

    while (scalar(@ProblemFiles) >= 1) {
        if (! -f $ProblemFiles[0]) {
            return(0);
        }
        shift(@ProblemFiles);
    }
    return(1);
}
