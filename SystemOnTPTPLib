sub ReportResult {
    my ($QuietFlag,$Prefix,$System,$Problem,$Status,$CPUTime,$RealTime,
$StatisticValues) = @_;

#----Must do these in a single print, for multiple copies writing up a pipe,
#----as used by SSCPA

#----If asking for only system output, put RESULT as comment. This is a HACK!
    if ($QuietFlag eq "-q01") {
        $Prefix = "% $Prefix";
        $QuietFlag = 1;
    }
    if (QuietPrintCheck($QuietFlag,2)) {
        print("$Prefix $Problem - $System says $Status - CPU = $CPUTime WC = $RealTime $StatisticValues\n");
    } else {
        if (QuietPrintCheck($QuietFlag,3)) {
            print("$Problem $Status $CPUTime $RealTime $StatisticValues\n");
        }
    }
}
#--------------------------------------------------------------------------------------------------
sub QuietPrint {
    my ($QuietFlag,$QuietCeiling,$OutputString) = @_;

#----Only print if the $QuietFlag <= $QuietCeiling
    if ($OutputString =~ /!!!/ || QuietPrintCheck($QuietFlag,$QuietCeiling)) {
        print($OutputString);
    }
}
#--------------------------------------------------------------------------------------------------
sub QuietPrintCheck {
    my ($QuietFlag,$QuietCeiling) = @_;

    my $QuietLevel;

    $QuietLevel = QuietLevelFromFlag($QuietFlag);

    return(($QuietFlag =~ /-q0\d+/ && $QuietLevel == $QuietCeiling) ||
($QuietFlag !~ /-q0\d+/ && $QuietLevel <= $QuietCeiling));
}
#--------------------------------------------------------------------------------------------------
sub QuietLevelFromFlag {

    my ($QuietFlag) = @_;

    my $QuietLevel;

#----Extract the quietness level
    if ($QuietFlag =~ /-q\d+/) {
        ($QuietLevel) = ($QuietFlag =~ /-q0*(\d+)/);
    } else {
        $QuietLevel = 0;
    }

    return($QuietLevel);
}
