sub PrepareProblems {
    my ($QuietFlag,$TemporaryDirectory,$System,$Transform,$Format,@ProblemFiles) = @_;

    my $ProblemFileHandle = "ProblemFileHandle";
    my $PPCHandle = "PPCHandle";
    my @PPCs;
    my $CantFormatFile;
    my $ProblemFileLine;
    my $Problem;
    my $ProblemFile;
    my $FileNamesArgument;
    my $NumberOfFilesThisTime;
    my @ErrorLines;
    my @ProblemFilesThisTime;
    my @FormatterOutput;
    my $FormatterLine;
    my $FormatterInputFile;
    my $FormatterOutputFile;
    my @FormatterOutputFiles;
    my $TPTPStyleOutputFile;
    my $ExtraTPTP4XFlags;

#----Load the list of preparation constraints
    if (open($PPCHandle,"<$PPCFilename")) {
        @PPCs = <$PPCHandle>;
        close($PPCHandle);
    } else {
        print("WARNING: No $PPCFilename\n");
        @PPCs = ();
    }
    $CantFormatFile = "$TemporaryDirectory/CantFormatFile";

    @FormatterOutputFiles = ();
    while (@ProblemFiles) {
        @ProblemFilesThisTime = ();
        $NumberOfFilesThisTime = 0;
        @FormatterOutput = ();
        while ($#ProblemFilesThisTime < 100 && @ProblemFiles) {
            $ProblemFile = shift(@ProblemFiles);
            NoNastyUNIX($ProblemFile);
            $Problem = `basename '$ProblemFile' .p`;
            chomp($Problem);
#----Print the TPTP format file if available
            if (QuietPrintCheck($QuietFlag,0)) {
                NoNastyUNIX($ProblemFile);
                if (open($ProblemFileHandle,"<$ProblemFile")) {
                    QuietPrint($QuietFlag,0,"\n${System}'s TPTP format $ProblemFile is ...\n");
                    while(defined($ProblemFileLine = <$ProblemFileHandle>)) {
                        QuietPrint($QuietFlag,0,"$ProblemFileLine");
                    }
                    QuietPrint($QuietFlag,0,"\n");
                    close($ProblemFileHandle);
                } else {
                    QuietPrint($QuietFlag,0,
"${System}'s file $ProblemFile not found, but maybe the formatter will\n");
                }
            }
#----Check if formatter will cope
            if (!FormatterCanCope($Problem,$Format,$Transform,@PPCs)) {
                QuietPrint($QuietFlag,1,"${System}'s format not available for $Problem\n");
                open($ProblemFileHandle,">> $CantFormatFile") or
die("ERROR: Cannot append to $CantFormatFile\n");
                print($ProblemFileHandle "ERROR: Cannot format $Problem\n");
                close($ProblemFileHandle);
                push(@FormatterOutputFiles,("$ProblemFile -> $CantFormatFile"));
                QuietPrint($QuietFlag,0,"$System   will use $CantFormatFile\n");
            } else {
#----Avoid adding a leading space
                push(@ProblemFilesThisTime,($ProblemFile));
                $NumberOfFilesThisTime++;
            }
        }
#DEBUG print("About to prepare $NumberOfFilesThisTime problems\n");
#DEBUG print("They are ... @ProblemFilesThisTime\n");

#----Check if any work to be done
        if ($NumberOfFilesThisTime == 0) {
            if (open($ProblemFileHandle,"<$CantFormatFile")) {
                if (QuietPrintCheck($QuietFlag,0)) {
                    QuietPrint($QuietFlag,0,
"${System}'s can't format source file is ...\n");
                    while(defined($ProblemFileLine = <$ProblemFileHandle>)) {
                        QuietPrint($QuietFlag,0,"$ProblemFileLine");
                    }
                }
                close($ProblemFileHandle);
            } else {
                die("ERROR: $CantFormatFile cannot be opened\n");
            }
        } else {
#----If tptp:raw format and all readable files, do nothing
            if ($Format =~ /.*:raw/ && $Transform eq "none" && 
AllReadableFiles(@ProblemFilesThisTime)) {
                QuietPrint($QuietFlag,2,"${System}'s $Problem does not need preparation\n");
                foreach $ProblemFile (@ProblemFilesThisTime) {
                    push(@FormatterOutput,("$ProblemFile -> $ProblemFile\n"));
                }
#----If no transform and tptp format, use tptp4X, else use tptp2X
            } elsif (TPTP4XCanDo($System,$Transform,$Format,@ProblemFilesThisTime)) {
                $ExtraTPTP4XFlags = GetExtraTPTP4XFlags($System);
#----Print the tptp4X parameters
                QuietPrint($QuietFlag,2,"${System}'s $Problem being prepared by $tptp4XCommand\n");
                QuietPrint($QuietFlag,2,"    -d $TemporaryDirectory " .
    ( $ExtraTPTP4XFlags eq "" ? "" : "\n$ExtraTPTP4XFlags") . "
    -t $Transform 
    -f $Format
    -x 
    -u machine
    @ProblemFilesThisTime\n");
                @FormatterOutput = DoTPTP4X($TemporaryDirectory,$ExtraTPTP4XFlags,$Transform,
$Format,@ProblemFilesThisTime);
            } else {
#----Print the tptp2X parameters
                QuietPrint($QuietFlag,2,"${System}'s $Problem being prepared by $tptp2XCommand\n");
                QuietPrint($QuietFlag,2,"    -d $TemporaryDirectory 
    -t $Transform 
    -f $Format
    @ProblemFilesThisTime\n");
#----Run tptp2X and extract the output file name
                @FormatterOutput = DoTPTP2X($TemporaryDirectory,$Transform,$Format,
@ProblemFilesThisTime);
            }

#DEBUG print("Reformatter said\n====@FormatterOutput====\n");
#----Look for errors in output
            @ErrorLines = grep(m|ERROR:|,@FormatterOutput);
            if (scalar(@ErrorLines) > 0) {
                @FormatterOutput = ();
            } else {
                @FormatterOutput = grep(m| -> |,@FormatterOutput);
            }
#DEBUG print("Need $NumberOfFilesThisTime lines in \n@FormatterOutput\n");

#----Extract the output file names
            if ($NumberOfFilesThisTime > scalar(@FormatterOutput)) {
                print("ERROR: Formatter did not create all the $System format files\n");
                if (scalar(@ErrorLines) > 0) {
                    print(@ErrorLines);
                } else {
                    print("       (Possibly the problem does not exist)\n");
                    print("       (Possibly the \"$Format\" format module is currently unavailable)\n");
                }
                die("\n");
            }
            foreach $FormatterLine (@FormatterOutput) {
                chomp($FormatterLine);
                ($FormatterInputFile,$FormatterOutputFile) = ($FormatterLine =~ / *(.*) -> (.*)/);

#----If a .tptp file, revert to .p for IDIOT systems like E-SETHEO
#                if ($FormatterOutputFile =~ /\.tptp$/) {
#                    $TPTPStyleOutputFile = $FormatterOutputFile;
#                    $TPTPStyleOutputFile =~ s/tptp$/p/;
#                    system("mv $FormatterOutputFile $TPTPStyleOutputFile");
#                    $FormatterOutputFile = $TPTPStyleOutputFile;
#                }

#----Check the output file exists and can be read
                QuietPrint($QuietFlag,0,"$System   will use $FormatterOutputFile\n");
                NoNastyUNIX($FormatterOutputFile);
                if (open($ProblemFileHandle,"<$FormatterOutputFile")) {
                    if (QuietPrintCheck($QuietFlag,0)) {
                        QuietPrint($QuietFlag,0,"${System}'s own format source file is ...\n");
                        while(defined($ProblemFileLine = <$ProblemFileHandle>)) {
                            QuietPrint($QuietFlag,0,"$ProblemFileLine");
                        }
                        QuietPrint($QuietFlag,0,"\n");
                    }
                    close($ProblemFileHandle);
                } else {
                    die("ERROR: Formatter output $FormatterOutputFile not found\n");
                }

#----Add this one to the list
#DEBUG print("Adding $FormatterInputFile -> $FormatterOutputFile to list\n");
                push(@FormatterOutputFiles,("$FormatterInputFile -> $FormatterOutputFile"));
#DEBUG print("List is now @FormatterOutputFiles\n");
            }
        }
    }

    return(@FormatterOutputFiles);
} 
#--------------------------------------------------------------------------------------------------
sub FormatterCanCope {
    my ($Problem,$SystemFormat,$SystemTransform,@PPCs) = @_;

    my @ProblemLines;
    my $ProblemLine;
    my $PPCFormat;
    my $PPCTransform;

    @ProblemLines = grep(/^\Q$Problem\E /,@PPCs);
    if (scalar(@ProblemLines) > 0) {
        foreach $ProblemLine (@ProblemLines) {
            chomp($ProblemLine);
            ($PPCFormat,$PPCTransform) = ($ProblemLine =~ /^\Q$Problem\E +([^ ]+) +([^ ]+)/);
            if (
#----Format constraints
($PPCFormat eq "*" || $PPCFormat eq $SystemFormat || 
#----Allow tptp variants - tptp:raw, oldtptp, tptp:short, tptp:long
($PPCFormat eq "tptp" && $SystemFormat =~ /tptp/)) &&
#----Transform constraints
($PPCTransform eq "*" || $PPCTransform eq $SystemTransform)) {
                return(1);
            }
        }
#----None of the options match the system requirements
        return(0);
    } else {
        return(1);
    }
}
#--------------------------------------------------------------------------------------------------
sub CreateExecuteString {

    my ($ExecuteFormatString,$ProblemFileName,$TimeLimit) = @_;

    my $ExecuteString;

    SWITCH: {
        if ($ExecuteFormatString =~ /%s.*%d/) {
            $ExecuteString = sprintf($ExecuteFormatString,$ProblemFileName,
$TimeLimit);
            last SWITCH;
        }
        if ($ExecuteFormatString =~ /%d.*%s/) {
            $ExecuteString = sprintf($ExecuteFormatString,$TimeLimit,
$ProblemFileName);
            last SWITCH;
        }
        if ($ExecuteFormatString =~ /%s/) {
            $ExecuteString = sprintf($ExecuteFormatString,$ProblemFileName);
            last SWITCH;
        }
        $ExecuteString = $ExecuteFormatString;
    }

    return($ExecuteString);
}
