sub GetFileNameLike {
    my ($FileNamePattern,$MaximalInList,$LSFlag) = @_;

    my @ListedFiles;

    @ListedFiles = `ls $LSFlag $FileNamePattern 2>&1`;
    if (scalar(@ListedFiles) >= 1 && $ListedFiles[0] !~
/No such file or directory/) {
        chomp($ListedFiles[0]);
        if (scalar(@ListedFiles) > $MaximalInList) {
            print(
"WARNING: Too many files like $FileNamePattern, returning none of them\n");
#DEBUG print("The are ==@ListedFiles==\n");
            return(undef);
        }
        if (scalar(@ListedFiles) >= 2) {
            print(
"WARNING: Multiple files $FileNamePattern, returning $ListedFiles[0]\n");
        }
        return($ListedFiles[0]);
    } else {
        return(undef);
    }
}
