sub DoTPTP2X {
    my ($TemporaryDirectory,$Transform,$Format,@ProblemFiles) = @_;

    my $ProblemFiles;
    my $ProblemFile;

    NoNastyUNIX("$tptp2XCommand -d $TemporaryDirectory -t '$Transform' -f '$Format' @ProblemFiles");
    $ProblemFiles = "";
    foreach $ProblemFile (@ProblemFiles) {
        $ProblemFiles .= "'$ProblemFile' ";
    }
    return(`$tptp2XCommand -d $TemporaryDirectory -t '$Transform' -f '$Format' $ProblemFiles 2>&1 | cat`);
}
