if (exists($ENV{TPTP_HOME})) {
    $TPTPDirectory = $ENV{TPTP_HOME};
}

my $SystemsDirectory = "$TPTPDirectory/Systems";
my $GetSystemInfoCommand = "$SystemsDirectory/GetSystemInfo";
my $LibraryDirectory = "$TPTPDirectory/TPTP";
my $ProblemsDirectory = "$LibraryDirectory/Problems";
my $PPCFilename = "$TPTPDirectory/SystemExecution/ProblemPreparationConstraints";
