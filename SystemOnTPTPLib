sub TPTP4XCanDo {
    my ($System,$Transform,$Format,@ProblemFiles) = @_;

    my @Transforms;
    my $File;

    if ($System =~ /^tptp2X/) {
#DEBUG print(STDERR "tptp2X requested\n");
        return(0);
    }

    if ($Format ne "tptp" && $Format ne "tptp:short" && $Format ne "tptp:long"
&& $Format ne "tptp:raw" && $Format ne "oldtptp" && $Format ne "dfg" && $Format ne "otter") {
#DEBUG print(STDERR "$Format is not possible in tptp4X\n");
        return(0);
    }

#----Split transforms at +
    @Transforms = split(/\+/,$Transform);

    foreach $Transform (@Transforms) {
        if ($Transform ne "none" && $Transform !~ /add_equality/ && $Transform !~ /fofify/ && 
$Transform !~ /aritize/ && $Transform !~ /dequote/) {
#DEBUG print(STDERR "$Transform is not OK\n");
            return(0);
        }
#DEBUG print(STDERR "$Transform is OK\n");
    }
#DEBUG print(STDERR "@Transforms are all OK\n");

#----Must be plain files
    foreach $File (@ProblemFiles) {
#----Strip off any ''s around the file name
        $File =~ s/^'//;
        $File =~ s/'$//;
        if (! -f $File && !ATPTPProblem($File)) {
#DEBUG print(STDERR "==$File== is not a plain file\n");
            return(0);
        }
    }

    return(1);
}
