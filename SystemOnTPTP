#----A cut down version of this without SPCForProblem is in UpdateTSTP
sub SystemCanDoProblem {
    my ($QuietFlag,$System,$Problem,$ProblemFile) = @_;

    my $SPCOfProblem;
    my @SPCsOfProblem;
    my $SPCOfSystem;
    my @SPCsOfSystem;
    my $SPCOfSystemComponent;
    my @SPCOfSystemComponents;
    my $SPCOK;
    my @SPCForProblemOutput;

    my @CheckTheseSPCComponents = (
"NHF","NH1","NH0",
"NXF","NX1","NX0",
"THF","TH1","TH0",
"TXF","TX1","TX0",
"TFF","TF1","TF0",
"FOF","CNF","RFO","NEQ","SEQ","PEQ","HRN","UEQ","EPR","PRP","ARI","NAR");

#----Get SPCs capacity for system
    if (!(-x $GetSystemInfoCommand)) {
        die("ERROR: $GetSystemInfoCommand not available\n");
    }
    $SPCOfSystem = `$GetSystemInfoCommand $System SPCs`;
    chomp($SPCOfSystem);
#DEBUG print("% SPCOfSystem $SPCOfSystem\n");
    ($SPCOfSystem) = ($SPCOfSystem =~ /.*=> *([^;]*); *$/);
#----If no SPCs then assume all
    if ($SPCOfSystem eq "" || $SPCOfSystem eq "NO INFORMATION") {
        return(1);
    }

#----Get SPC of problem. First try quick look if from TPTP
    if (!(-x $SPCForTPTPProblem)) {
        die("ERROR: $SPCForTPTPProblem not available\n");
    }
#DEBUG print("% TRY $SPCForTPTPProblem $ProblemFile\n");
    $SPCOfProblem = `$SPCForTPTPProblem '$ProblemFile'`;
    chomp($SPCOfProblem);
#DEBUG print("%=TPTP===$SPCOfProblem===\n");
#----If was not TPTP problem or something, do from scratch
    if (grep(/ERROR/,$SPCOfProblem)) {
        if (!(-x $SPCForProblem)) {
            die("ERROR: $SPCForProblem not available\n");
        }
#----If problem file not found (TPTP problem without SPC?) assume OK
        if (! -e $ProblemFile) {
            QuietPrint($QuietFlag,2,
"WARNING: Guessing that $System can cope with this non-TPTP problem\n");
            return(1);
        }
#DEBUG system("cat \"$ProblemFile\"");
#DEBUG print("Doing: $RunSolverCommand -C $SPCForProblemTimeLimit $SPCForProblem $ProblemFile\n");
        @SPCForProblemOutput = `$RunSolverCommand -C $SPCForProblemTimeLimit $SPCForProblem "$ProblemFile"`;
#DEBUG print("SPCForProblem says\n@SPCForProblemOutput");
        $SPCOfProblem = $SPCForProblemOutput[0];
#DEBUG print("The first line of output is $SPCOfProblem\n");
        chomp($SPCOfProblem);
    }
#DEBUG print("% RAW SPCForProblemOutput ===@SPCForProblemOutput===\n");
#----If something went wrong then no hope
    if ($SPCOfProblem =~ /^ERROR/) {
        if ($SPCOfProblem =~ /MakeTreeStats ran out of CPU time/) {
            QuietPrint($QuietFlag,2,
"WARNING: Guessing that $System can cope with this problem (timeout getting the SPC)\n");
            return(1);
        } else {
#            QuietPrint($QuietFlag,2,
#"WARNING: Guessing that $System can't cope with this problem (error getting the SPC)\n");
            return(-1);
        }
    }
    @SPCsOfProblem = split(/_/,$SPCOfProblem);
#DEBUG print("% SPCsOfProblem @SPCsOfProblem\n");

    @SPCsOfSystem = split(/ +/,$SPCOfSystem);
#DEBUG print("% SPCsOfSystem @SPCsOfSystem\n");
#----Check if any one of the system's SPCs covers this problem
    foreach $SPCOfSystem (@SPCsOfSystem) {
        @SPCOfSystemComponents = split(/_/,$SPCOfSystem);
#----If any meaningful component cannot be found in problem, fail this one
#DEBUG print("% Checking if problem is @SPCOfSystemComponents\n");
        $SPCOK = 1;
        foreach $SPCOfSystemComponent (@SPCOfSystemComponents) {
#DEBUG print("% Checking if problem component is $SPCOfSystemComponent\n");
            if (grep(/$SPCOfSystemComponent/,@CheckTheseSPCComponents) &&
!grep(/$SPCOfSystemComponent/,@SPCsOfProblem)) {
#DEBUG print("% Nope problem is not $SPCOfSystemComponent\n");
                $SPCOK = 0;
                last;
            }
        }
        if ($SPCOK) {
#DEBUG print("% Problem is @SPCOfSystemComponents\n");
            return(1);
        }
    }
#DEBUG print("% Nope, can't cope\n");
    return(0);
}
