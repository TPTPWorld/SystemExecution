sub CHLDHandler {
    my ($Signal) = @_;
    
    printf("A child of SystemOnTPTP $$ died\n");
}
#---------------------------------------------------------------------------------------------------
sub ALRMHandler {
    my ($Signal) = @_;
    
#DEBUG print("!!!SystemOnTPTP $$ received a $Signal\n");

#DEBUG print("!!!$GlobalPIDToStop did not stop on QUIT, now KILL\n");
#----SIGKILL doesn't work. Have to use -9 (but does that kill the group?)
#    kill('SIGKILL',$GlobalPIDToStop);
    QUITHandler('SIGXCPU');
}
#---------------------------------------------------------------------------------------------------
sub QUITHandler {
    my ($Signal) = @_;

    $GlobalInterrupted = 1;
    SetGlobalInterruptedInLib();

    if ($GlobalPIDToStop > 0) {
#DEBUG print("!!!SystemOnTPTP $$ stops child $GlobalPIDToStop with $Signal\n");
        kill($Signal,$GlobalPIDToStop);
    } else {
#DEBUG print("!!!SystemOnTPTP $$ prover never got started, so I won't kill it\n");
    }

    if ($Signal eq 'INT') {
        die("Terminated by ^C\n");
    }
}
