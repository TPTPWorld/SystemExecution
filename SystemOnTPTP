sub SystemOnTPTPVersionSetup {
    my ($QuietFlag,@CommandLineArguments) = @_;

    my $Argument;
    my $ThisMachineName;
    my $ThisScriptCommand = "$SystemExecutionDirectory/SystemOnTPTP";

    if (!defined($ThisMachineName = `$GetMachineName`)) {
        die("ERROR: Cannot get this machine name\n");
    }
    chomp($ThisMachineName);

#----Check that we're on the right machine, else rsh across
    if ($ThisMachineName !~ /$ExpectedMachineName/i) {
        QuietPrint($QuietFlag,2,"Moving onto $ExecutionMachine\n");
#----Quote the arguments before rsh
        foreach $Argument (@ARGV) {
            $Argument =~ s/^/'/;
            $Argument =~ s/$/'/;
        }
        exec("$rshCommand $ExecutionMachine $ThisScriptCommand $QuietFlag @CommandLineArguments");
        die("Could not exec rsh $ExecutionMachine\n");
    } else {
#----Set the execution machine to be this one
        $ExecutionMachine = $ThisMachineName;
    }
}
