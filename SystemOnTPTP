sub DoSystemOnTPTP {
    my ($QuietFlag,$ForceSystemFlag,$TemporaryDirectory,$System,@FlagsTimeAndProblems) = @_;

    my @ProblemFiles;
    my $ProblemFile;
    my $Problem;
    my $Format;
    my $Transform;
    my $TimeLimit;
    my $WCTimeLimit;
    my $MemoryLimit;
    my $NiceValue;
    my $NeedToPrepareProblems;
    my $NeedOtter2TPTP;
    my $UseX2tptp;
    my $UsingSoTFlag;
    my $PreparedFile;
    my @PreparedFiles;
    my $ExecuteFormatString;
    my $Status;
    my $CPUTime;
    my $RealTime;
    my $OutputStatus;
    my $OutputCPUTime;
    my $OutputRealTime;
    my $StatisticValues;
    my $CanDo;

#----Check all parameters
    ($ExecuteFormatString,$Format,$Transform,$TimeLimit,$WCTimeLimit,$MemoryLimit,$NiceValue,
$NeedToPrepareProblems,$NeedOtter2TPTP,$UseX2tptp,$UsingSoTFlag,@ProblemFiles) = 
CheckParameters($QuietFlag,$System,$TemporaryDirectory,@FlagsTimeAndProblems);

#DEBUG print("ExecuteFormatString = $ExecuteFormatString\n");
#DEBUG print("Format              = $Format\n");
#DEBUG print("Transform           = $Transform\n");
#DEBUG print("TimeLimit           = $TimeLimit\n");
#DEBUG print("ProblemFiles        = @ProblemFiles\n");

#----Convert from Otter format
    if ($NeedOtter2TPTP) {
        @ProblemFiles = ConvertFromOtter($QuietFlag,$TemporaryDirectory,@ProblemFiles);
    }
#----Prepare problem with tptp2X or tptp4X or whatever
    if ($NeedToPrepareProblems) {
        @PreparedFiles = PrepareProblems($QuietFlag,$TemporaryDirectory,$System,$Transform,$Format,
@ProblemFiles);
    } else {
        @PreparedFiles = @ProblemFiles;
    }

#----Execute the system
    foreach $PreparedFile (@PreparedFiles) {

#----Extract problem name for reporting
#----First case is output from tptp2X or tptp4X
#DEBUG print("%>>>$PreparedFile<<<\n");
        if ($PreparedFile =~ / -> /) {
            ($ProblemFile,$PreparedFile) = ($PreparedFile =~ /(.*) -> (.*)/);
            $Problem = `basename '$ProblemFile'`;
            chomp($Problem);
            $Problem =~ s/\.[a-z]*$//;
#----Other case is direct list of files, not run through tptp2X or tptp4X
        } else {
            $ProblemFile = shift(@ProblemFiles);
            $Problem = `basename '$ProblemFile' '\\.[a-z]*'`;
            chomp($Problem);
            $Problem =~ s/\.[a-z]*$//;
        }
        if (!defined($Problem)) {
           die("Could not get basename from $ProblemFile\n");
        }

#----Check if the problem is suitable for this system's SPCs. 
        if ($ForceSystemFlag eq "-force") {
            QuietPrint($QuietFlag,1,"$System   is forced to process that problem/solution\n");
            $CanDo = 1;
        } elsif ($TimeLimit <= 0) {
#----TimeLimit < 0 means just postprocessing, so cope!
            $CanDo = 1;
        } else {
            $CanDo = SystemCanDoProblem($QuietFlag,$System,$Problem,$ProblemFile);
        }
        if ($CanDo == 0) {
            QuietPrint($QuietFlag,2,
"$System   is unable to process that form of problem/solution\n");
            ($Status,$CPUTime,$RealTime,$OutputStatus,$OutputCPUTime,$OutputRealTime,
$StatisticValues) = ("Inappropriate",0.0,0.0,"None",0.0,0.0,"");
        } elsif ($CanDo == -1 && $Format ne "tptp:raw") {
#----Some error in SystemCanDoProblem. Error has been reported there. But ignore for tptp:raw 
#----systems that can probably cope.
            ($Status,$CPUTime,$RealTime,$OutputStatus,$OutputCPUTime,$OutputRealTime,
$StatisticValues) = ("Error (getting SPC)",0.0,0.0,"None",0.0,0.0,"");
        } else {
            if ($CanDo == -1 && $Format =~ /.*:raw/) {
                QuietPrint($QuietFlag,2,"$System   being fed the raw form of $Problem\n");
            }
            ($Status,$CPUTime,$RealTime,$OutputStatus,$OutputCPUTime,$OutputRealTime,
$StatisticValues) = ExecuteSystem($QuietFlag,$System,$Problem,$PreparedFile,$ExecuteFormatString,
$TimeLimit,$WCTimeLimit,$MemoryLimit,$NiceValue,$UseX2tptp,$UsingSoTFlag);
#----If a FOF problem with a conjecture, convert Unsatisfiable to Theorem
            $Status = FixFOFResult($Status,$PreparedFile);
        }

#----Report the result only if not piping to X2tptp (in which case it is
#----done in ExecuteSystem - AAAARGH this is getting into a hack!
        if (!$UseX2tptp || QuietLevelFromFlag($QuietFlag) <= 2) {
            ReportResult($QuietFlag,"RESULT:",$System,$Problem,$Status,$CPUTime,$RealTime,
$StatisticValues);
            ReportResult($QuietFlag,"OUTPUT:",$System,$Problem,$OutputStatus,$OutputCPUTime,
$OutputRealTime,"");
        }

#----Bail out if interrupted
        if ($GlobalInterrupted) {
            last;
        }
    }
}
