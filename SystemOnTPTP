sub GetProblemTPTPVersion {
    my ($FileName) = @_;

    my %ProblemHeaderFields;
    my $ProblemTPTPVersion;

    %ProblemHeaderFields = GetHeaderFields("$FileName");
    if (exists($ProblemHeaderFields{"File"})) {
        ($ProblemTPTPVersion) = ($ProblemHeaderFields{"File"} =~
/.*(TPTP v\d+\.\d+\.\d+\. .* v\d+\.\d+\.\d+)\. *$/);
    } else {
        undef($ProblemTPTPVersion);
    }

    if (!defined($ProblemTPTPVersion)) {
        $ProblemTPTPVersion = "v?.?.?";
    }

    return($ProblemTPTPVersion);
}
#---------------------------------------------------------------------------------------------------
sub GetHeaderFields {
    my ($FileName) = @_;

    my $ProblemFileHandle = "ProblemFileHandle";
    my $FileLine;
    my $CommentChar;
    my $FieldName;
    my $FieldContent;
    my $MoreContent;
    my %HeaderFields;

#----These lines added to prevent the pipe hack
    NoNastyUNIX($FileName);
#DEBUG print("Getting header fields from $FileName\n");
    open($ProblemFileHandle,"<$FileName") or
die("ERROR: Cannot open $FileName to get headers\n");

    $FileLine = <$ProblemFileHandle>;
    while (defined($FileLine) && 
!(defined($FieldName) && ($FieldName eq "Comments"))) {
        chomp($FileLine);
#DEBUG print("File line is ==$FileLine==\n");
#----Does it look like a header field
        if ($FileLine =~ /^[^ \w] \w* +:/) {
            ($CommentChar,$FieldName) = ($FileLine =~ /^(.) (\w+) +:/);
#DEBUG print("Found $FieldName\n");
            ($FieldContent) = 
($FileLine =~ /^$CommentChar $FieldName +: *(.*)/);
#----Allow for empty field content, but more on a following line
            if (!defined($FieldContent)) {
                $FieldContent = "";
            }
            $FileLine = <$ProblemFileHandle>;
            while (defined($FileLine) && 
$FileLine =~ /^$CommentChar      +/) {
                chomp($FileLine);
                ($MoreContent) = ($FileLine =~ /^$CommentChar +(.*)/);
                $FieldContent .= "\n$MoreContent";
                $FileLine = <$ProblemFileHandle>;
            }
#DEBUG print("Field name = $FieldName\n");
#DEBUG print("Field content = $FieldContent\n");
            $HeaderFields{$FieldName} = $FieldContent;
        } else {
            $FileLine = <$ProblemFileHandle>;
        }
    }
    close($ProblemFileHandle);

    return(%HeaderFields);
}
