sub ExecuteSystem {
    my ($QuietFlag,$System,$Problem,$ProblemFile,$ExecuteFormatString,$TimeLimit,$WCTimeLimit,
$MemoryLimit,$NiceValue,$UseX2tptp,$UsingSoTFlag) = @_;

    my $ExecuteString;
    my $PrintExecuteString;
    my $TimeLimitedExecuteString;
    my $ThisNiceCommand;
    my $SystemFileHandle = "SystemFileHandle";
    my $ATPSystemPID;
    my $Status;
    my $CPUTime;
    my $RealTime;
    my $OutputStatus;
    my $OutputCPUTime;
    my $OutputRealTime;
    my $StatisticValues;
    my $OldSTDOUT = "OldSTDOUT";
    my $X2tptpExtractorHandle = "X2tptpExtractorHandle";
    my $RunQuietFlag;
    my $ProblemTPTPVersion;

#DEBUG print("ProblemFile $ProblemFile\n");
#DEBUG print("Problem $Problem\n");

    if ($TimeLimit == 0) {
        return("Success",0,0,"None",0,0,"");
    }

#----Prepare for child process
    $ExecuteString = CreateExecuteString($ExecuteFormatString,"'$ProblemFile'",$TimeLimit);
#----Hide -p fields from printed ExecuteString because they are Q&A passwords
#----That sucks because it hides some other types of -p parameters
    $PrintExecuteString = $ExecuteString;
    $PrintExecuteString =~ s/ -p [^ ]* / /;
    QuietPrint($QuietFlag,2,"$System   being executed on $Problem using $PrintExecuteString\n");

#----Build a nice command if needed
    if ($NiceValue != 0) {
        $ThisNiceCommand = "$NiceCommand $NiceValue";
    } else {
        $ThisNiceCommand = "";
    }
#DEBUG print("The nice command is ==$ThisNiceCommand==\n");

#----Negative time limit is postprocessing only, and I'll trust that
    if ($TimeLimit >= 0) {
        $TimeLimitedExecuteString = sprintf($RunSolverFormatString,
$ThisNiceCommand,$RunSolverCommand,$TimeLimit,$WCTimeLimit,$MemoryLimit,$ExecuteString);
    } else {
        $TimeLimitedExecuteString = $ExecuteString;
    }

#----These lines added to prevent the pipe hack
    NoNastyUNIX($TimeLimitedExecuteString);
#----At last moment check for interrupt
    if (!$GlobalInterrupted) {
#DEBUG print("Run TimeLimitedExecuteString ==$TimeLimitedExecuteString== ");
#DEBUG system("date '+%T %N'");
#----Store the PID globally for interrupt handler
        if (!defined($ATPSystemPID = open($SystemFileHandle,"-|"))) {
            die("ERROR: Cannot fork system process\n");
        }
    
#----Check which process we're in. 0 means child
        if ($ATPSystemPID == 0) {
#----Close the pipe to read from
            close($SystemFileHandle);
#----Maybe interrupt comes during open => no value in $GlobalPIDToStop
#----while in interrupt handler, but really the child must not start
            exec($TimeLimitedExecuteString) or
die("Cannot exec $TimeLimitedExecuteString\n");

#----Otherwise in parent
        } else {
            $GlobalPIDToStop = $ATPSystemPID;
            if ($GlobalInterrupted) {
#----Allow the exec to bite in the child before stopping it
                sleep(1);
                QUITHandler('QUIT');
            }
#----Special set up for X2tptp post processing, pass this process' STDOUT to
#----X2tptpExtractor (to avoid lots of programming :-)
#----THIS IS WHERE I NEED TO FIX, SO I CAN ECHO THE OUTPUT AND CATCH THE X2TPTP
#----OUTPUT TO ECHO
            if ($UseX2tptp) {
                $ProblemTPTPVersion = GetProblemTPTPVersion($ProblemFile);
#----These lines added to prevent the pipe hack
                NoNastyUNIX("$X2tptpFormatterCommand $UsingSoTFlag $System $Problem $ProblemTPTPVersion $ProblemFile $ExecutionMachine $TimeLimit --");
#----Place the same time limit on postprocessing - should really be combined but that requires big
#----changes and postprocessing time is seldom a big issue. Also, there's a moral debate whether
#----the system should be charged for my postprocessing time.
                $TimeLimitedExecuteString = sprintf("%s %s -C %d -W %d -M %d --delay 1 %s",
$ThisNiceCommand,$RunSolverCommand,$TimeLimit,$WCTimeLimit,$MemoryLimit,
"$X2tptpFormatterCommand $UsingSoTFlag $System '$Problem' '$ProblemTPTPVersion' '$ProblemFile' $ExecutionMachine $TimeLimit --");
#DEBUG print("WOULD I RUN ===$TimeLimitedExecuteString===\n");
                $GlobalPIDToStop = open($X2tptpExtractorHandle,"|$TimeLimitedExecuteString") or
die("ERROR: Cannot run X2tptpExtractor");
                open($OldSTDOUT,">&STDOUT") or 
die("ERROR: Can't dup STDOUT: $!");
                close(STDOUT);
                open(STDOUT,">&$X2tptpExtractorHandle") or 
die("ERROR: Cannot dup STDOUT to X2tptpExtractor");
                $| = 1;
                $RunQuietFlag = "-q1";
            } else {
                $RunQuietFlag = $QuietFlag;
            }

            ($Status,$CPUTime,$RealTime,$OutputStatus,$OutputCPUTime,$OutputRealTime,
$StatisticValues) = StatusFromSystemOutput($RunQuietFlag,$SystemFileHandle,$System,$TimeLimit,
$WCTimeLimit);
#DEBUG print("Ran TimeLimitedExecuteString ==$TimeLimitedExecuteString== ");
#DEBUG system("date '+%T %N'");

            if ($UseX2tptp) {
                $Status = FixFOFResult($Status,$ProblemFile);
#----Report the result (duplicated from above - needed for -S flag)
                ReportResult($RunQuietFlag,"RESULT:",$System,$Problem,$Status,$CPUTime,$RealTime,
$StatisticValues);
                ReportResult($RunQuietFlag,"OUTPUT:",$System,$Problem,$OutputStatus,
$OutputCPUTime,$OutputRealTime,"");
#----If these closes are done in the other order then X2tptpExtractor does 
#----not end, and I don't know why.
                close(STDOUT);
                close($X2tptpExtractorHandle);
                open(STDOUT,">&$OldSTDOUT") or die("ERROR: Can't undup STDOUT: $!");
            }

#----Close file handle
            close($SystemFileHandle);

#----Wait in either case for child to end
#----No need to wait, as it seems by using open to start the process
#----this has been taken care of. How I wonder? Maybe in close.
#        if (waitpid($ForkPID,64) == -1) {
#            print("WARNING: SystemOnTPTP $$ child $ForkPID has disappeared\n");
#        }
        }
    } else {
        ($Status,$CPUTime,$RealTime,$OutputStatus,$OutputCPUTime,$OutputRealTime,
$StatisticValues) = ("Unknown",0,0,"None",0,0,"");
    }

    return($Status,$CPUTime,$RealTime,$OutputStatus,$OutputCPUTime,$OutputRealTime,
$StatisticValues) ;
}
