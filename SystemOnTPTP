#!/usr/bin/perl -w

#----Run a specified system on a specified TPTP problem

use strict "vars";
#--------------------------------------------------------------------------------------------------
my $TPTPDirectory = "/home/tptp";

if (exists($ENV{TPTP_HOME})) {
    $TPTPDirectory = $ENV{TPTP_HOME};
}
if (! exists($ENV{TPTP})) {
    $ENV{TPTP} = "$TPTPDirectory/TPTP";
}
if (! -d $ENV{TPTP}) {
    die("ERROR: Cannot find TPTP directory\n");
}

my $SystemsDirectory = "$TPTPDirectory/Systems";
my $GetSystemInfoCommand = "$SystemsDirectory/GetSystemInfo";
my $SystemExecutionDirectory = "$TPTPDirectory/SystemExecution";
my $TreeLimitedRunCommand = "$SystemExecutionDirectory/TreeLimitedRun";
my $RunSolverCommand = "$SystemExecutionDirectory/runsolver -w /dev/null ";
my $RunSolverFormatString = "%s %s -C %d -W %d -M %d --delay 1 --timestamp --add-eof %s";
#---- my $RunSolverCommand = "$SystemExecutionDirectory/ResourceLimitedRun";
my $X2tptpFormatterCommand = "$TPTPDirectory/TSTP/X2TPTP/X2tptpExtractor";
my $SPCForTPTPProblem = "$TPTPDirectory/SPCs/SPCForTPTPProblem";
my $SPCForProblem = "$TPTPDirectory/SPCs/SPCForProblem";
my $GetMachineName = "/bin/hostname";

require "$SystemExecutionDirectory/SystemOnTPTPLib";

#----If you want execution of the ATP system to be done on a certain computer,
#----e.g., not on your desktop but some other work computer, then set the
#----following variables. The $ExpectedMachineName is a regexp to match the
#----return from $GetMachineName, and if it does not match then the job is
#----transferred to the $ExecutionMachine using $rshCommand.
my $ExpectedMachineName = ".*";
my $ExecutionMachine = "wombat.cs.miami.edu";
my $rshCommand = "ssh";

my $NiceCommand = "/bin/nice -n";
my $DefaultTemporaryDirectory = "/tmp/SystemOnTPTP$$";
my $SPCForProblemTimeLimit = 30;

#----Global for use by signal handler
my $GlobalPIDToStop = 0;
my $GlobalInterrupted = 0;

#----Global for use in END statements
my $GlobalKeepTemporaryDirectory;
my $GlobalTemporaryDirectory;

#--------------------------------------------------------------------------------------------------
DoMain();
#--------------------------------------------------------------------------------------------------
sub DoMain {

#----Send QUIT signals to the right place
    $SIG{'QUIT'} = 'QUITHandler';
    $SIG{'XCPU'} = 'QUITHandler';
    $SIG{'INT'}  = 'QUITHandler';
    $SIG{'PIPE'} = 'QUITHandler';
    $SIG{'ALRM'} = 'ALRMHandler';
#    $SIG{'CHLD'} = 'SIGCHLDHandler';

#----Send STDERR to STDOUT
    close(STDERR);
    open(STDERR,">&STDOUT");
#----Flush output
    $| = 1;

    ($GlobalTemporaryDirectory,$GlobalKeepTemporaryDirectory) = 
RunSystemOnTPTP($DefaultTemporaryDirectory);

    END {
        if (!$GlobalKeepTemporaryDirectory && defined($GlobalTemporaryDirectory)) {
            system("rm -rf $GlobalTemporaryDirectory");
        }
    }
}
